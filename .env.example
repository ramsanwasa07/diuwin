# ==============================================================
# DiuWin Gaming Platform - Production Environment Variables
# ==============================================================

# Server Environment & Port
NODE_ENV=production
PORT=3000

# SQLite Database File Path (defaults to .data/diuwin.sqlite)
DATABASE_PATH=.data/diuwin.sqlite

# Security & Master Admin Static Token (Optional fallback)
ADMIN_STATIC_TOKEN=diuwin_master_secure_admin_token_2026

# Payment Gateway Configuration (e.g. Razorpay, Cashfree, UPI QR)
PAYMENT_GATEWAY_KEY=your_payment_gateway_key_here
PAYMENT_GATEWAY_SECRET=your_payment_gateway_secret_here
PAYMENT_WEBHOOK_SECRET=your_webhook_signature_secret_here

# SMS Gateway Configuration for Real OTP Delivery (e.g. MSG91, Fast2SMS, Twilio)
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key_here
SMS_SENDER_ID=DIUWIN
